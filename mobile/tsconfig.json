{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    // `**/*.ts` does not match `.mts`, so the live-check script — real code
    // driving the real client modules — went unchecked until a duplicate
    // `const` reached a live run.
    "**/*.mts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
